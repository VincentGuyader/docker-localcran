# ─────────────────────────────────────────────────────────────────────────────
# Crandore — fichier de configuration
#
# Copiez ce fichier en .env et adaptez les valeurs à votre environnement :
#   cp .env.example .env
#
# Le fichier .env est ignoré par git (données locales / domaine / ports).
# ─────────────────────────────────────────────────────────────────────────────


# ── Chemin des dépôts ─────────────────────────────────────────────────────────
# Répertoire racine où les dépôts CRAN sont stockés sur le serveur hôte.
# Utilisé par tous les services (build, serve, etc.).
#
CRANDORE_REPOS_PATH=/srv/cran-repos


# ── Serveur HTTP local (service crandore-serve) ───────────────────────────────
# Lance Caddy en HTTP uniquement, accessible sur le réseau local.
# Commande : docker compose up crandore-serve
#
# Adresse d'écoute de Caddy (port 80 interne = CRANDORE_SERVE_PORT sur l'hôte)
CRANDORE_SERVE_ADDRESS=:80

# Port exposé sur l'hôte
CRANDORE_SERVE_PORT=8080


# ── Serveur HTTPS public (service crandore-serve-https) ───────────────────────
# Lance Caddy avec Let's Encrypt. Caddy obtient le certificat automatiquement.
# Requiert : domaine DNS pointant sur ce serveur, ports 80 et 443 libres.
# Commande : docker compose up crandore-serve-https
#
# Pour activer : remplacer :80 par votre domaine
#   CRANDORE_SERVE_ADDRESS=cran.monserveur.fr
#   CRANDORE_SERVE_PORT=80
#   CRANDORE_SERVE_HTTPS_PORT=443


# ── Construction (service crandore-stack) ────────────────────────────────────
# Fichier stack.yml décrivant les dépôts à construire.
#
CRANDORE_STACK_FILE=./stack.yml

# Filtres optionnels (laisser vide = pas de filtre)
CRANDORE_ONLY_DATE=
CRANDORE_ONLY_PROFILE=


# ── Init (service crandore-init) ─────────────────────────────────────────────
# Valeurs par défaut proposées lors de la génération d'un stack.yml.
# Modifiables aussi directement en ligne de commande.
#
CRANDORE_PACKAGES=tidyverse
CRANDORE_INIT_DISTROS=jammy,noble,centos8
CRANDORE_INIT_R_VERSIONS=4.4
CRANDORE_INIT_WINDOWS=true
CRANDORE_INIT_WINDOWS_R_VERSIONS=
CRANDORE_INIT_ARM=false
CRANDORE_FULL_SNAPSHOT=false
CRANDORE_LOCAL_ROOT=/minicran
